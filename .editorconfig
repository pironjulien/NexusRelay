# Shared C# style and analyzer settings (the build enforces them: see Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[tests/**.cs]
# xUnit test names read as sentences (Method_Does_This): underscores are the convention there.
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# Names that mirror the relay's own vocabulary (RelayError, AgentApiFailure, Call, Short) in an application, not a
# reusable library: the .NET library naming rules do not apply.
dotnet_diagnostic.CA1710.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none

[tests/**.cs]
# Daemon, pipe and wait tests block on purpose with a bounded Wait(timeout, token) to assert the deadline itself.
dotnet_diagnostic.xUnit1031.severity = none
