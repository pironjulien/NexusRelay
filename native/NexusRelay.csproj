<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NexusRelay</AssemblyName>
    <RootNamespace>NexusRelay</RootNamespace>
    <Version>1.15.1</Version>
    <!-- Both release architectures in the restore graph, so packages.lock.json covers the release publishes. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Native AOT: the releases (get.ps1 zips, .mcpb bundles) carry one NexusRelay.exe compiled ahead of time per
         architecture (no .NET to install, no JIT at start-up, less memory for the daemon that runs all day). The
         trimming, single-file and AOT analyzers run in every build and, with warnings as errors, no reflection-based
         JSON, runtime COM binder or runtime-marshalled call can come back. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ToolContracts.json" LogicalName="NexusRelay.ToolContracts.json" />
    <EmbeddedResource Include="UiContracts.json" LogicalName="NexusRelay.UiContracts.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.2" />
  </ItemGroup>
</Project>
