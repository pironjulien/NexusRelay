{
  "mcpServers": {
    "nexus-relay": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${PLUGIN_ROOT}\\scripts\\bridge.ps1",
        "-Url",
        "http://127.0.0.1:16181/mcp?agent=antigravity",
        "-Product",
        "NexusRelay"
      ]
    }
  }
}
