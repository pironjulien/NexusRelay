{
  "description": "Nexus Relay: before each file edit, refused only if another holder explicitly reserved the file (exclusive), else a short advisory lease is taken for the tool call (a note names any other edit running on the file); after the tool, the lease is released, whatever the Git state; at the end of the turn or the session, all of them. At the end of a turn, the answers to the requests the conversation still has open are awaited in the background and wake it (asyncRewake). Unread messages for Claude (the host is never woken) are noted to the conversation, once each. NexusRelay.exe from the stable path its installer keeps.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --edit-guard claude || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --edit-guard claude --finish-tool || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --edit-guard claude --finish-tool || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --edit-guard claude --finish-session || true",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --await-replies claude",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --edit-guard claude --finish-session || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --notice || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.nexus/nexus-relay/bin/NexusRelay.exe\" --notice || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
