#!/bin/sh
# Garde de commit Nexus Relay (installée par scripts/install_commit_guard.ps1) : une fois le commit fait, libère les
# réservations automatiques (hook d'édition) de l'agent qui l'a fait sur les fichiers commités.
py="$HOME/.nexus/nexus-relay/venv/Scripts/python.exe"
[ -x "$py" ] || exit 0
PYTHONUTF8=1 "$py" -B -m nexus_relay.reservations --release-committed || true
