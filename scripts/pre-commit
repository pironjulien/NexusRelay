#!/bin/sh
# Garde de commit Nexus Relay (installée par scripts/install_commit_guard.ps1) : refuse un commit qui touche un fichier
# réservé par un AUTRE agent ; l'agent qui commite est reconnu par ses processus parents. Moteur natif par son chemin
# stable (~/.nexus/nexus-relay/bin, tenu à jour par install.ps1).
exe="$HOME/.nexus/nexus-relay/bin/NexusRelay.exe"
if [ ! -f "$exe" ]; then
    echo "Nexus Relay : garde de commit inactive (relais non installé sur ce PC)" >&2
    exit 0
fi
exec "$exe" --staged
