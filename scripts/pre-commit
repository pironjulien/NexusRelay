#!/bin/sh
# Garde de commit Nexus Relay (installée par scripts/install_commit_guard.ps1) : refuse un commit qui touche un fichier
# réservé par un AUTRE agent ; l'agent qui commite est reconnu par ses processus parents.
py="$HOME/.nexus/nexus-relay/venv/Scripts/python.exe"
if [ ! -x "$py" ]; then
    echo "Nexus Relay : garde de commit inactive (relais non installé sur ce PC)" >&2
    exit 0
fi
PYTHONUTF8=1 exec "$py" -B -m nexus_relay.reservations --staged
